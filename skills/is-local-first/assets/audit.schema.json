{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "is-local-first audit v1",
  "description": "A static audit of one data flow in a pinned project snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "project", "version", "commit", "platform", "scope",
    "syncMode", "rubricVersion", "verification", "localFirstClaim", "maturity",
    "criteria"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "repository": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "version": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[^\\r\\n]+)?$",
      "maxLength": 128
    },
    "commit": {"$ref": "#/$defs/commit"},
    "platform": {"$ref": "#/$defs/text"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dataFlow"],
      "properties": {
        "kind": {"enum": ["application", "database", "sync-engine"]},
        "dataFlow": {"$ref": "#/$defs/text"}
      }
    },
    "syncMode": {"$ref": "#/$defs/text"},
    "rubricVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "adoptedOn"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "adoptedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "verification": {"type": "string", "const": "static"},
    "localFirstClaim": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["quote", "source"],
      "properties": {
        "quote": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/httpsUrl"},
        "translation": {"$ref": "#/$defs/text"}
      }
    },
    "maturity": {
      "enum": ["stable", "beta", "alpha", "experimental", "maintenance", "unclear", "pre-1.0"]
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline", "devicePrimary", "fullHistory", "anyServer", "e2ee",
        "postQuantum", "keysNotAccounts", "openSource"
      ],
      "properties": {
        "offline": {"$ref": "#/$defs/standardCriterion"},
        "devicePrimary": {"$ref": "#/$defs/standardCriterion"},
        "fullHistory": {"$ref": "#/$defs/standardCriterion"},
        "anyServer": {"$ref": "#/$defs/standardCriterion"},
        "e2ee": {"$ref": "#/$defs/standardCriterion"},
        "postQuantum": {"$ref": "#/$defs/standardCriterion"},
        "keysNotAccounts": {"$ref": "#/$defs/criterion"},
        "openSource": {"$ref": "#/$defs/standardCriterion"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "httpsUrl": {"type": "string", "pattern": "^https://"},
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence", "source", "quote"],
      "properties": {
        "value": {"enum": ["meets", "partial", "misses", "n/a", "unclear"]},
        "evidence": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/httpsUrl"},
        "quote": {"$ref": "#/$defs/text"}
      }
    },
    "standardCriterion": {
      "$ref": "#/$defs/criterion",
      "properties": {"value": {"enum": ["meets", "partial", "misses", "unclear"]}}
    }
  }
}
